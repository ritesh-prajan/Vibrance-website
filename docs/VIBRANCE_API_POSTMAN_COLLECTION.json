        {
          "name": "Register New Student Attendee",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regNumber\": \"21BCE9999\",\n  \"name\": \"Siddharth Rao\",\n  \"email\": \"siddharth.rao@vibrance.edu\",\n  \"department\": \"Computer Science & Engineering (SCOPE)\",\n  \"yearOfStudy\": \"3rd Year (B.Tech)\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Get Authenticated Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Festival Events Catalog",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        },
        {
          "name": "Get Event By Code (CYBERQUEST)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/code/evt-cyberquest?includeSeats=true",
              "host": ["{{baseUrl}}"],
              "path": ["events", "code", "evt-cyberquest"],
              "query": [
                { "key": "includeSeats", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Create New Festival Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"NEON CARNIVAL: LASER ARENA\",\n  \"category\": \"PRO_SHOW\",\n  \"artistOrHost\": \"DJ Shaan & Lost Amphitheatre\",\n  \"date\": \"Fri, Sep 4, 2026\",\n  \"time\": \"09:00 PM IST\",\n  \"venue\": \"Outdoor Amphitheatre\",\n  \"basePrice\": 599.00,\n  \"totalSeats\": 48,\n  \"tag\": \"SPECIAL ATTRACTION\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["events"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Seats & Strict 2PL Reservation Leases",
      "item": [
        {
          "name": "Get Seat Grid for Event",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/seats/event/e0000000-0000-0000-0000-000000000005",
              "host": ["{{baseUrl}}"],
              "path": ["seats", "event", "e0000000-0000-0000-0000-000000000005"]
            }
          }
        },
        {
          "name": "Lock Seat (Strict 2PL Growing Phase Lease - Checkout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatId\": \"{{seatId}}\",\n  \"leaseDurationSeconds\": 180\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/seats/lock",
              "host": ["{{baseUrl}}"],
              "path": ["seats", "lock"]
            }
          }
        },
        {
          "name": "Release Seat Lease",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/seats/{{seatId}}/release",
              "host": ["{{baseUrl}}"],
              "path": ["seats", "{{seatId}}", "release"]
            }
          }
        }
      ]
    },
    {
