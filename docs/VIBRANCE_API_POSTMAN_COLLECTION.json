              "raw": "{\n  \"eventId\": \"e0000000-0000-0000-0000-000000000005\",\n  \"seatId\": \"{{seatId}}\",\n  \"name\": \"Rahul Sharma\",\n  \"regNumber\": \"RA2111003010142\",\n  \"department\": \"Computer Science & Engineering (SCOPE)\",\n  \"paymentMethod\": \"UPI\"\n}"
