{
  "info": {
    "_postman_id": "vibrance-2026-api-collection",
    "name": "Vibrance 2026 Festival API Suite",
    "description": "Comprehensive REST API Collection for Vibrance 2026 – College DBMS Project & Concurrency Demonstration Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
