              "mode": "raw",
              "raw": "{\n  \"regNumber\": \"RA2111003010142\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login - Gatekeeper Persona (Rajesh)",
          "request": {
            "method": "POST",
            "header": [
